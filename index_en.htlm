<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vardelume | LegalTech & Document Processing Infrastructure</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                            900: '#14532d',
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased selection:bg-brand-500 selection:text-white">

    <!-- HEADER / NAVBAR -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-slate-950/80 border-b border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <span class="text-2xl font-black tracking-wider bg-gradient-to-r from-brand-400 to-emerald-200 bg-clip-text text-transparent">VARDELUME</span>
            </div>
            <nav class="hidden md:flex items-center space-x-8 text-sm font-medium text-slate-300">
                <a href="#diagnostic" class="hover:text-brand-400 transition">Diagnostic</a>
                <a href="#platform" class="hover:text-brand-400 transition">Platform</a>
                <a href="#subscriptions" class="hover:text-brand-400 transition">Subscriptions</a>
            </nav>
            <div class="flex items-center space-x-4">
                <a href="#subscriptions" class="px-5 py-2.5 text-sm font-semibold rounded-xl bg-brand-600 hover:bg-brand-500 text-white shadow-lg shadow-brand-600/20 transition">Pro Access</a>
            </div>
        </div>
    </header>

    <!-- HERO SECTION -->
    <section class="relative pt-20 pb-24 overflow-hidden border-b border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-brand-950/50 border border-brand-800 text-brand-400 text-xs font-semibold mb-6">
                <span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span>
                <span>Advanced Legal & Translation Infrastructure</span>
            </div>
            <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight max-w-4xl mx-auto leading-tight mb-8">
                Global scale legal and contract automation
            </h1>
            <p class="text-lg sm:text-xl text-slate-400 max-w-2xl mx-auto mb-10">
                Integrate expert review, document processing, and AI-powered legal translation with secure workflows backed by PostgreSQL and Vercel.
            </p>
            <div class="flex flex-col sm:flex-row justify-center gap-4">
                <a href="#diagnostic" class="px-8 py-4 rounded-xl bg-brand-600 hover:bg-brand-500 text-white font-bold text-base shadow-xl shadow-brand-600/30 transition">Start Free Diagnostic</a>
                <a href="#subscriptions" class="px-8 py-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 font-bold text-base border border-slate-700 transition">View Plans</a>
            </div>
        </div>
    </section>

    <!-- DIAGNOSTIC SECTION (HOOK) -->
    <section id="diagnostic" class="py-20 bg-slate-900/40">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold tracking-tight mb-3">Online Legal Diagnostic</h2>
                <p class="text-slate-400">Answer 2 brief questions to evaluate the risk exposure of your cross-border contracts and documents.</p>
            </div>

            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-10 shadow-2xl">
                <!-- Step 1 -->
                <div id="diag-step-1" class="space-y-6">
                    <label class="block text-lg font-semibold text-slate-200">
                        1. What is the approximate monthly volume of legal documents or contracts processed?
                    </label>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <button onclick="setVol(10)" class="p-4 rounded-xl border border-slate-700 bg-slate-800/50 hover:border-brand-500 text-center transition font-medium">Under 20 docs</button>
                        <button onclick="setVol(50)" class="p-4 rounded-xl border border-slate-700 bg-slate-800/50 hover:border-brand-500 text-center transition font-medium">20 - 100 docs</button>
                        <button onclick="setVol(150)" class="p-4 rounded-xl border border-slate-700 bg-slate-800/50 hover:border-brand-500 text-center transition font-medium">100+ docs</button>
                    </div>
                </div>

                <!-- Step 2 (Initially hidden) -->
                <div id="diag-step-2" class="space-y-6 hidden">
                    <label class="block text-lg font-semibold text-slate-200">
                        2. Do you require certified bilingual validation (Spanish / Legal English)?
                    </label>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <button onclick="runDiagnostic(true)" class="p-4 rounded-xl border border-slate-700 bg-slate-800/50 hover:border-brand-500 text-center transition font-semibold text-brand-400">Yes, high demand</button>
                        <button onclick="runDiagnostic(false)" class="p-4 rounded-xl border border-slate-700 bg-slate-800/50 hover:border-brand-500 text-center transition font-semibold">Standard usage</button>
                    </div>
                </div>

                <!-- Diagnostic Result -->
                <div id="diag-result" class="hidden text-center space-y-6 py-4">
                    <div class="inline-flex p-4 bg-brand-950 border border-brand-800 rounded-full text-brand-400 mb-2">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    </div>
                    <h3 class="text-2xl font-bold text-white">Diagnostic Successfully Completed</h3>
                    <p id="diag-text-out" class="text-slate-300 max-w-lg mx-auto text-sm sm:text-base"></p>
                    <div class="pt-4">
                        <a href="#subscriptions" class="inline-block px-8 py-3 rounded-xl bg-brand-600 hover:bg-brand-500 text-white font-bold transition shadow-lg shadow-brand-600/30">View Recommended Subscription</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SUBSCRIPTION PLANS SECTION -->
    <section id="subscriptions" class="py-24 border-t border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4">Subscription Plans</h2>
                <p class="text-slate-400 text-lg">Choose the right infrastructure tier for your legal operations volume.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch">
                
                <!-- Basic Plan -->
                <div class="bg-slate-900 border border-slate-800 rounded-3xl p-8 flex flex-col justify-between transition hover:border-slate-700">
                    <div>
                        <h3 class="text-xl font-bold mb-2 text-slate-100">Basic</h3>
                        <p class="text-slate-400 text-sm mb-6">Ideal for independent professionals and emerging notary offices.</p>
                        <div class="flex items-baseline mb-8">
                            <span class="text-4xl sm:text-5xl font-black">$190</span>
                            <span class="text-slate-400 ml-2 text-sm">/ mo</span>
                        </div>
                        <ul class="space-y-4 text-sm text-slate-300 mb-8">
                            <li class="flex items-center gap-3">✓ Up to 25 documents / mo</li>
                            <li class="flex items-center gap-3">✓ Automated legal translation</li>
                            <li class="flex items-center gap-3">✓ Standard ticket support</li>
                        </ul>
                    </div>
                    <button onclick="subscribe('Basic', 190)" class="w-full py-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 font-bold border border-slate-700 transition">Select Basic</button>
                </div>

                <!-- Standard Plan (Highlighted) -->
                <div class="bg-slate-900 border-2 border-brand-500 rounded-3xl p-8 flex flex-col justify-between relative shadow-2xl shadow-brand-500/10">
                    <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-brand-600 text-white text-xs uppercase tracking-wider font-extrabold px-4 py-1.5 rounded-full">Most Popular</div>
                    <div>
                        <h3 class="text-xl font-bold mb-2 text-slate-100">Standard</h3>
                        <p class="text-slate-400 text-sm mb-6">Designed for law firms and growth agencies.</p>
                        <div class="flex items-baseline mb-8">
                            <span class="text-4xl sm:text-5xl font-black text-brand-400">$490</span>
                            <span class="text-slate-400 ml-2 text-sm">/ mo</span>
                        </div>
                        <ul class="space-y-4 text-sm text-slate-300 mb-8">
                            <li class="flex items-center gap-3 text-brand-300">✓ Up to 120 documents / mo</li>
                            <li class="flex items-center gap-3 text-brand-300">✓ Advanced bilingual review (ES/EN)</li>
                            <li class="flex items-center gap-3 text-brand-300">✓ Priority Neon DB integration</li>
                            <li class="flex items-center gap-3 text-brand-300">✓ Priority 24/7 support</li>
                        </ul>
                    </div>
                    <button onclick="subscribe('Standard', 490)" class="w-full py-3.5 rounded-xl bg-brand-600 hover:bg-brand-500 text-white font-bold transition shadow-lg shadow-brand-600/30">Select Standard</button>
                </div>

                <!-- Corporate Plan -->
                <div class="bg-slate-900 border border-slate-800 rounded-3xl p-8 flex flex-col justify-between transition hover:border-slate-700">
                    <div>
                        <h3 class="text-xl font-bold mb-2 text-slate-100">Corporate</h3>
                        <p class="text-slate-400 text-sm mb-6">Comprehensive unlimited solution for large corporations.</p>
                        <div class="flex items-baseline mb-8">
                            <span class="text-4xl sm:text-5xl font-black">$980</span>
                            <span class="text-slate-400 ml-2 text-sm">/ mo</span>
                        </div>
                        <ul class="space-y-4 text-sm text-slate-300 mb-8">
                            <li class="flex items-center gap-3">✓ Unlimited documents / mo</li>
                            <li class="flex items-center gap-3">✓ Dedicated Vercel infrastructure</li>
                            <li class="flex items-center gap-3">✓ Exclusive account manager</li>
                        </ul>
                    </div>
                    <button onclick="subscribe('Corporate', 980)" class="w-full py-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 font-bold border border-slate-700 transition">Select Corporate</button>
                </div>

            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="py-12 border-t border-slate-800 bg-slate-950 text-center text-slate-500 text-sm">
        <p>&copy; 2026 Vardelume. All rights reserved.</p>
    </footer>

    <!-- JAVASCRIPT: DIAGNOSTIC & CHECKOUT HOOKS -->
    <script>
        let selectedVolume = 0;

        function setVol(val) {
            selectedVolume = val;
            document.getElementById('diag-step-1').classList.add('hidden');
            document.getElementById('diag-step-2').classList.remove('hidden');
        }

        function runDiagnostic(highDemand) {
            document.getElementById('diag-step-2').classList.add('hidden');
            const resultBox = document.getElementById('diag-result');
            resultBox.classList.remove('hidden');

            let recommendation = '';
            if (selectedVolume <= 10 && !highDemand) {
                recommendation = 'We recommend the **Basic Subscription ($190/mo)** to cover your specific needs with total legal security.';
            } else if (selectedVolume <= 50 || highDemand) {
                recommendation = 'We recommend the **Standard Subscription ($490/mo)**. It is the optimal plan for your volume and bilingual requirements.';
            } else {
                recommendation = 'We recommend the **Corporate Subscription ($980/mo)** to guarantee unlimited capacity and dedicated support.';
            }

            document.getElementById('diag-text-out').innerHTML = recommendation;
        }

        function subscribe(planName, price) {
            // Ready to connect with your backend API (Neon + Prisma + Stripe/PayPal)
            alert('Redirecting to secure gateway for ' + planName + ' Plan ($' + price + ' USD)...');
        }
    </script>
</body>
</html>
